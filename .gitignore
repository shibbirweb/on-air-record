# Rust
/backend/target/
**/*.rs.bk

# Node
node_modules/
# The frontend build output is ignored by frontend/.gitignore, which also keeps dist/.gitkeep so the
# directory exists at compile time for the embedded UI.
/frontend/.vite/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data (recordings, sqlite database, logs)
/data/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.pcm

# Environment
.env
.env.local

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
